    "laravel/reverb": "^1.0",
    "laravel/horizon": "^5.24",
    "laravel/scout": "^10.8",
    "guzzlehttp/guzzle": "^7.8",
    "meilisearch/meilisearch-php": "^1.7",
    "smalot/pdfparser": "^2.10",
    "stripe/stripe-php": "^14.0",
    "predis/predis": "^2.2"
