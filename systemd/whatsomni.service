[Unit]
Description=WhatsOmni v3.0 Enterprise Application Server
After=network.target

[Service]
Type=simple
User=whatsomni
Group=whatsomni
WorkingDirectory=/var/www/whatsomni
Environment=NODE_ENV=production
Environment=PORT=3000
EnvironmentFile=/var/www/whatsomni/.env.production
ExecStart=/usr/bin/node /var/www/whatsomni/dist/server.js
Restart=always
RestartSec=5
KillSignal=SIGTERM
TimeoutStopSec=10
LimitNOFILE=65535
StandardOutput=journal
StandardError=journal
SyslogIdentifier=whatsomni-app

[Install]
WantedBy=multi-user.target
